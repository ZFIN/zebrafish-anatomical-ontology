            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A male germ cell that develops from the haploid secondary spermatocytes. Without further division, spermatids undergo structural changes and give rise to spermatozoa.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-10-04T03:51:27Z</oboInOwl:creation_date>
