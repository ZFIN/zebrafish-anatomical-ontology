            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A connective tissue cell of an organ found in the loose connective tissue. These are most often associated with the uterine mucosa and the ovary as well as the hematopoietic system and elsewhere.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000499</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0009226</oboInOwl:hasDbXref>
