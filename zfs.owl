                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Region of the neural plate that will give rise to the neural crest. The neural plate border includes progenitors for the dorsal neural tube, the neural crest, and placodes. It is a broad competence domain, established between neural and non-neural ectoderm within which subtle and sequential cell autonomous and non-cell autonomous molecular interactions will progressively define the neural crest fate from adjacent dorsal neural fates.</obo:IAO_0000115>
        <oboInOwl:created_by>yvonne</oboInOwl:created_by>
        <oboInOwl:creation_date>2016-01-28T08:43:28Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0007082</oboInOwl:id>
        <rdfs:label>neural plate border</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0007082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Region of the neural plate that will give rise to the neural crest. The neural plate border includes progenitors for the dorsal neural tube, the neural crest, and placodes. It is a broad competence domain, established between neural and non-neural ectoderm within which subtle and sequential cell autonomous and non-cell autonomous molecular interactions will progressively define the neural crest fate from adjacent dorsal neural fates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ymb</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORCID:0000-0002-9900-7880</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:22305800</oboInOwl:hasDbXref>
    </owl:Axiom>
    


