        <oboInOwl:hasExactSynonym>transverse process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001362</oboInOwl:id>
        <rdfs:label>parapophysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
