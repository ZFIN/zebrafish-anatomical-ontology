    <!-- http://purl.obolibrary.org/obo/ZFA_0005241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005237"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely blue color, but takes on an acidophilic tint, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-08-11T03:38:32Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>CL:0000550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005241</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>intermediate erythroblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polychromatic erythroblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polychromatic normoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rubricyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>intermediate normoblast</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polychromatophilic normoblast</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0005241</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>polychromatophilic erythroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely blue color, but takes on an acidophilic tint, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-070221-1</oboInOwl:hasDbXref>
    </owl:Axiom>
    


