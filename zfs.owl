    <!-- http://purl.obolibrary.org/obo/ZFA_0000620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001591"/>
