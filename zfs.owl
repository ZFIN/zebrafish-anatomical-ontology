            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oocyte part of stage I ovarian follicle. Stage I oocytes are basophilic, and have relatively large nuclei.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001567</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Stage 1 oocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oocytes stage I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primary oocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
