    <!-- http://purl.obolibrary.org/obo/ZFA_0005779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001486"/>
