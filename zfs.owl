                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A primary motoneuron that is part of the spinal cord.  The axon of the CaP motoneuron on emerging from the ventral root.  At the horizontal septum, however, the RoP axon turns laterally to extend within the horizontal septum to the lateral surface of the muscle.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-18T04:05:40Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0005180</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>rostral primary motoneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005180</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>This term is a leaf node in the zebrafish AO and is not in the CL.</rdfs:comment>
        <rdfs:label>RoP motor neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A primary motoneuron that is part of the spinal cord.  The axon of the CaP motoneuron on emerging from the ventral root.  At the horizontal septum, however, the RoP axon turns laterally to extend within the horizontal septum to the lateral surface of the muscle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-1247</oboInOwl:hasDbXref>
