                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A spinal interneuron with a dorsal dendrite that extends caudally. CoLA also has  midlateral process that extend rostrally and caudally, the axon crosses the cord dorsal to the Mauthner cell and ascends, extending dorsally.  Axon has minor descending branch.  These neurons are glycinergic.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-17T04:14:51Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0005234</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>commissural longitudinal ascending interneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005234</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>CoLA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005234"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A spinal interneuron with a dorsal dendrite that extends caudally. CoLA also has  midlateral process that extend rostrally and caudally, the axon crosses the cord dorsal to the Mauthner cell and ascends, extending dorsally.  Axon has minor descending branch.  These neurons are glycinergic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ORCID:0000-0002-2244-7917</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-010807-17</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-230515-30</oboInOwl:hasDbXref>
    </owl:Axiom>
    


