    <!-- http://purl.obolibrary.org/obo/ZFA_0000464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001469"/>
        <rdfs:subClassOf>
