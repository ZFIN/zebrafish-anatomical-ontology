            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Primordium that forms the first neuromasts of the posterior lateral line.  This primordium travels at 1.5-1.7 somites/hour and deposits  neuromast that are polarized along the antero-posterior axis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0005115</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>primI</oboInOwl:hasExactSynonym>
