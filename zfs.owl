                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A fat-storing cell found mostly in the abdominal cavity and subcutaneous tissue of mammals. Fat is usually stored in the form of triglycerides. Cell that stores fat in a unilocular lipid droplet, has a thin circular cytoplasm and pericentral nucleus. The average adult adipocyte diameter is between 30 and 40 micrometers.  No adipocytes were observed in larvae on 6 or 9 dpf.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>ZFA:0009208</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>CL:0000136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CL:0000450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0009082</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0009208</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adipocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lipocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lipocytes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0009082</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>fat cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A fat-storing cell found mostly in the abdominal cavity and subcutaneous tissue of mammals. Fat is usually stored in the form of triglycerides. Cell that stores fat in a unilocular lipid droplet, has a thin circular cytoplasm and pericentral nucleus. The average adult adipocyte diameter is between 30 and 40 micrometers.  No adipocytes were observed in larvae on 6 or 9 dpf.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:curator</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-090417-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-101011-51</oboInOwl:hasDbXref>
    </owl:Axiom>
    


