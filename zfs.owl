        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>Oocytes reside in nests with other oocytes (Stage IA) and then within a definitive follicle (Stage IB), where they greatly increase in size ZDB-PUB-961014-1020.</rdfs:comment>
        <rdfs:label>oocyte stage I</rdfs:label>
    </owl:Class>
