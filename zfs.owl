        <oboInOwl:hasExactSynonym>renin secreting cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005238</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>juxtaglomerular cell</rdfs:label>
    </owl:Class>
