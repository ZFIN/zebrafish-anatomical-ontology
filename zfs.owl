        <obo:IAO_0000115>Hindbrain nucleus where climbing fibers originate. The neurons in the inferior olive are capable of prolonged oscillatory activity.  The inferior olive is called a precerebellar nucleus since virtually all of the efferent axons terminate in the cerebellum.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0000215</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0000215</oboInOwl:id>
        <rdfs:label>inferior olive</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hindbrain nucleus where climbing fibers originate. The neurons in the inferior olive are capable of prolonged oscillatory activity.  The inferior olive is called a precerebellar nucleus since virtually all of the efferent axons terminate in the cerebellum.</owl:annotatedTarget>
