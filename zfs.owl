    <!-- http://purl.obolibrary.org/obo/ZFA_0000421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001512"/>
