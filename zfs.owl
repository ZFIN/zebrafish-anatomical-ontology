                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of tissue that gives rise to the scale.  At the  initial stages the primordium  is composed of an accumulation of fibroblast below the basil epidermis.   As the primordium develops the epidermis over the fibroblast alters: the basal epidermal cells become cuboidal and narrow, the collagen matrix remodels and the hemidesmosomes disappear.</obo:IAO_0000115>
        <oboInOwl:created_by>Melissa  Haendel</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-08-05T03:35:05Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0002242</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>scale primordia </oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>scale placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0001704</oboInOwl:id>
        <rdfs:label>scale primordium</rdfs:label>
    </owl:Class>
