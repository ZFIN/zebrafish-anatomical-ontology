    <!-- http://purl.obolibrary.org/obo/ZFA_0005927 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005259"/>
