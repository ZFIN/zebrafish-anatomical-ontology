            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Bony process that develops as a dorsally  projecting cartilaginous extension from the basidorsal.  The ascending process is longer relative to the manubrium in larvae (5.1-11.0 mm). By 13.0 mm, the ascending process appears highly reduced in size.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001548</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001602</oboInOwl:id>
        <rdfs:label>intercalarium ascending process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001602"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Bony process that develops as a dorsally  projecting cartilaginous extension from the basidorsal.  The ascending process is longer relative to the manubrium in larvae (5.1-11.0 mm). By 13.0 mm, the ascending process appears highly reduced in size.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-031103-13</oboInOwl:hasDbXref>
    </owl:Axiom>
    


