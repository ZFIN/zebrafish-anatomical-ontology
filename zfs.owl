    <!-- http://purl.obolibrary.org/obo/ZFA_0001612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0001612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001306"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first pharyngeal arch, also known as the mandibular arch, forms the jaw. The first pharyngeal arch gives rise to elements of the jaw, with the most anteriorly positioned cranial neural crest cells contributing to mandibular arch structures, including Meckel&apos;s and palatoquadrate cartilages that constitute the lower and upper jaw respectively.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001595</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mandibular arch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>visceral arch 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001612</oboInOwl:id>
        <rdfs:label>pharyngeal arch 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The first pharyngeal arch, also known as the mandibular arch, forms the jaw. The first pharyngeal arch gives rise to elements of the jaw, with the most anteriorly positioned cranial neural crest cells contributing to mandibular arch structures, including Meckel&apos;s and palatoquadrate cartilages that constitute the lower and upper jaw respectively.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ymb</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORCID:0000-0002-9900-7880</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-020904-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-121120-12</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-985</oboInOwl:hasDbXref>
    </owl:Axiom>
    


