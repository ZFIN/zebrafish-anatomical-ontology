        <oboInOwl:hasExactSynonym>posterior crista ampullaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior cristae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior semicircular canal sensory patch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior semicircular canal sensory patches</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
