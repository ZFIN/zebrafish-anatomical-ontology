        <oboInOwl:id>ZFA:0009028</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>ameloblast</rdfs:label>
    </owl:Class>
