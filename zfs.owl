    <!-- http://purl.obolibrary.org/obo/ZFA_0005322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009038"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009374"/>
