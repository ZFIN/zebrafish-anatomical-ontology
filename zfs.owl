    <!-- http://purl.obolibrary.org/obo/ZFA_0001503 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0001503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001461"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
