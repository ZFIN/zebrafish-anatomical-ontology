        <oboInOwl:hasExactSynonym>KA interneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>KA neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kolmer-Agduhr cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal CSF-cN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal CSF-cNs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005240</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>Kolmer-Agduhr neuron</rdfs:label>
    </owl:Class>
