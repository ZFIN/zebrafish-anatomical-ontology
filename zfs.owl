        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005808</oboInOwl:id>
        <rdfs:comment>Appears after cardiac looping ~30hpf. Derived from mesoderm.</rdfs:comment>
        <rdfs:label>proepicardial cluster</rdfs:label>
    </owl:Class>
