            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Brainstem commissure located immediately rostral to the interpeduncular nucleus. Many fibers in the tecto-bulbar tract cross the midline through the ansulate commissure. Referred to as the ventral tegmental commissure at embryonic stages, and is the only commissure to change names during development. From Neuroanatomy of the Zebrafish Brain.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0000618</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Cans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>commissura ansulata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral tegmental commissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0000618</oboInOwl:id>
        <rdfs:label>ansulate commissure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
