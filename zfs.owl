        <oboInOwl:id>ZFA:0009124</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>chemoreceptor cell</rdfs:label>
    </owl:Class>
