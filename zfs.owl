                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Sensory canal between and in close proximity posteriorly with the post-otic and preoperculo-mandibular sensory canals, and anteriorly with the supraorbital and infraorbital sensory canals. The otic sensory canal is bilaterally paired.</obo:IAO_0000115>
