                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cranial nerve that innervates gill muscles.  Sometimes called a branchiomeric nerve because it innervates derivatives of the branchial arches.  This nerve contains sensory axons that carry both somatic and visceral sensory information as well as motor axons from branchiomotor neurons. The root is typically found at either rhombomere 7 or rhombomere 8.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0000453</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CN-X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vagal nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vagus nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0000453</oboInOwl:id>
        <rdfs:label>cranial nerve X</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cranial nerve that innervates gill muscles.  Sometimes called a branchiomeric nerve because it innervates derivatives of the branchial arches.  This nerve contains sensory axons that carry both somatic and visceral sensory information as well as motor axons from branchiomotor neurons. The root is typically found at either rhombomere 7 or rhombomere 8.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cvs</oboInOwl:hasDbXref>
