    <!-- http://purl.obolibrary.org/obo/ZFA_0005878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009016"/>
        <rdfs:subClassOf>
