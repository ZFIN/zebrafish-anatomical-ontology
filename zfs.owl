        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005313</oboInOwl:id>
        <rdfs:label>pronephric glomerular basement membrane</rdfs:label>
    </owl:Class>
