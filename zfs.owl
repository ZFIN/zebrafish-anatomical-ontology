                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Dermal bone that is rod-like, formed and usually contained in a fin membrane, and jointed to or adjacent to distal radials. They are bilaterally paired.  Lepidotrichia are formed from paired hemitrichia surrounding actinotrichia. There are usually two more lepidotrichia than distal radials.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001554</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fin ray</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lepidotrichia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001554</oboInOwl:id>
        <rdfs:label>lepidotrichium</rdfs:label>
    </owl:Class>
