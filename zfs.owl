        </rdfs:subClassOf>
        <obo:IAO_0000115>A naive B cell is a mature B cell that has the phenotype surface IgD-positive, surface IgM-positive, CD27-negative, and CD38-negative, and that has not yet been activated by antigen in the periphery.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000788</oboInOwl:hasDbXref>
