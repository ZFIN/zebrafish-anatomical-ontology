            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The exocrine pancreas is a diffuse organ composed of a branching network of ducts and associated acinar glands that manufacture the proteolytic enzymes and bicarbonate required for digestion.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001249</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
