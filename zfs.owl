                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of tissue formed between the base of the intestinal villi that is part of the intestinal epithelium where intestinal stem cells are located.  In the intestine no crypts are present, but, the regions between the villi, the intervillus pockets, have a crypt-like function. Cells are produced in the intervillus pockets and  shed from the villus tips.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-01-07T12:26:13Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0005256</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>intestinal crypt</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0005256</oboInOwl:id>
        <rdfs:label>intervillus pockets</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A portion of tissue formed between the base of the intestinal villi that is part of the intestinal epithelium where intestinal stem cells are located.  In the intestine no crypts are present, but, the regions between the villi, the intervillus pockets, have a crypt-like function. Cells are produced in the intervillus pockets and  shed from the villus tips.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-050209-3</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
