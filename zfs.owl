    <!-- http://purl.obolibrary.org/obo/ZFA_0007121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0007121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0007120"/>
