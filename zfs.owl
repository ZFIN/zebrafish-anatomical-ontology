        <oboInOwl:id>ZFA:0005323</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>ionocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
