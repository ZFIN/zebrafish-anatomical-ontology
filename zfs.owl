        <oboInOwl:hasRelatedSynonym>iridocyte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iridosome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0009199</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>iridophore</rdfs:label>
    </owl:Class>
