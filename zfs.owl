    <!-- http://purl.obolibrary.org/obo/ZFA_0007118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0007118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001477"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000126"/>
            </owl:Restriction>
