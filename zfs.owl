        <oboInOwl:hasRelatedSynonym>null cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>preNK cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0009348</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>pro-NK cell</rdfs:label>
    </owl:Class>
