    <!-- http://purl.obolibrary.org/obo/ZFA_0009075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0009075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009074"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A class of large neuroglial (macroglial) cells in the central nervous system - the largest and most numerous neuroglial cells in the brain and spinal cord. Astrocytes (from &apos;star&apos; cells) are irregularly shaped with many long processes, including those with &apos;end feet&apos; which form the glial (limiting) membrane and directly and indirectly contribute to the blood-brain barrier. They regulate the extracellular ionic and chemical environment, and &apos;reactive astrocytes&apos; (along with microglia) respond to injury.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000127</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0009075</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>astrocytes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0009075</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>astrocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A class of large neuroglial (macroglial) cells in the central nervous system - the largest and most numerous neuroglial cells in the brain and spinal cord. Astrocytes (from &apos;star&apos; cells) are irregularly shaped with many long processes, including those with &apos;end feet&apos; which form the glial (limiting) membrane and directly and indirectly contribute to the blood-brain barrier. They regulate the extracellular ionic and chemical environment, and &apos;reactive astrocytes&apos; (along with microglia) respond to injury.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:curator</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009075"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>astrocytes</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003004"/>
    </owl:Axiom>
    


