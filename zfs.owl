        <oboInOwl:hasExactSynonym>anterior crista ampullaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior cristae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior semicircular canal sensory patch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior semicircular canal sensory patches</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rostral crista</oboInOwl:hasExactSynonym>
