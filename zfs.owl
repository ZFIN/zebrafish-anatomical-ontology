                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cranial cartilage which is bilaterally paired and develops as a dorsal plate-like projection of the anteriolateral ethmoid plate, which are oriented perpendicular to the ethmoid plate. It fuses dorsally to the taenia marginalis anterior, and it joins the ethmoid cartilage medially.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001503</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>laminas orbitonasalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001503</oboInOwl:id>
        <rdfs:label>lamina orbitonasalis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
