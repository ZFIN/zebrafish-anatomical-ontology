    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005209"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005865"/>
