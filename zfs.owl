    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0007082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001477"/>
        <rdfs:subClassOf>
