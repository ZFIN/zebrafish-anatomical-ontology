        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005396</oboInOwl:id>
        <rdfs:label>supraorbital sensory canal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Sensory canal contained in the nasal and frontal bones.  It contains 4 or 5 neuromast. The first neuromast is positioned in the tubular nasal bone and the other neuromasts are located in the frontal bone.  The canal is anterior to and in close proximity to the otic and infraorbital sensory canals. The supraorbital sensory canal is bilaterally paired.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>TAO:curator</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-031103-11</oboInOwl:hasDbXref>
    </owl:Axiom>
    


