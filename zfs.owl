        <rdfs:comment>This term is a leaf node in the zebrafish AO and is not in the CL.</rdfs:comment>
        <rdfs:label>CoPA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005175"/>
