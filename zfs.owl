                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A unipolar spinal interneuron that forms dendritic trunk laterally with extensive dendritic branching.  The axon extends ventrally, lateral to the Mauthner axons before crossing the cord and descending ventrally.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
