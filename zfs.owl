                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Hindbrain interneuron that is part of rhombomere 1 with twelve neurons in each hemi-rhombomere. Axon runs in the dorsal spinal cord. The RoL1 stem axon projects ipsilaterally along the brain stem and spinal cord. From the more lateral location of its spinal axon, RoL1&apos;s collaterals projected both ventrally and medially.  The branching of RoL1 collaterals within the medulla, occur at multiple levels.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-23T03:22:51Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0005194</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>rostral lateral 1 interneuron </oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005194</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>May have 12  neurons in each hemi rhombomere ZDB-PUB-060217-9.
7 neurons in each hemi rhombomere 080227-17 and 931014-770.</rdfs:comment>
        <rdfs:label>RoL1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005194"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hindbrain interneuron that is part of rhombomere 1 with twelve neurons in each hemi-rhombomere. Axon runs in the dorsal spinal cord. The RoL1 stem axon projects ipsilaterally along the brain stem and spinal cord. From the more lateral location of its spinal axon, RoL1&apos;s collaterals projected both ventrally and medially.  The branching of RoL1 collaterals within the medulla, occur at multiple levels.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-030319-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-770</oboInOwl:hasDbXref>
    </owl:Axiom>
    


