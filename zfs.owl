    <!-- http://purl.obolibrary.org/obo/ZFA_0000641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0007009"/>
        <rdfs:subClassOf>
