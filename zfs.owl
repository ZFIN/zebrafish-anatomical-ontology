    <!-- http://purl.obolibrary.org/obo/ZFA_0009123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0009123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
