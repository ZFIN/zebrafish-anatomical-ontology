                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ionocytes associated with neuromasts. Nm ionocytes are not present at the time of neuromast deposition, and are derived from basal keratinocytes surrounding neuromasts. Nm ionocyte progenitors migrate into neuromasts as pairs of cells. The invasion process is triggered in response to changing environmental stimuli such as salinity and pH.</obo:IAO_0000115>
        <oboInOwl:created_by>zfinf</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-08-15T15:20:01Z</oboInOwl:creation_date>
