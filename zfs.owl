        <oboInOwl:hasRelatedSynonym>unipolar commissural descending interneuron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0005235</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>UCoD</rdfs:label>
    </owl:Class>
    <owl:Axiom>
