    <!-- http://purl.obolibrary.org/obo/ZFA_0000423 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000082"/>
