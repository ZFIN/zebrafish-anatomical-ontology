    <!-- http://purl.obolibrary.org/obo/ZFA_0005179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009244"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A primary motor neuron that is part of the spinal cord.   The axon turns caudally and dorsally, coursing between the surface of the spinal cord and the medial surface of the axial muscles to the dorsal median septum. The MiP axon then extends dorsally to the surface of the muscle, where it turns to arborize ventrally over the lateral surface of the axial muscle.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-18T04:02:28Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TAO:0005179</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>middle primary motoneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005179</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>This term is a leaf node in the zebrafish AO and is not in the CL.</rdfs:comment>
        <rdfs:label>MiP motor neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A primary motor neuron that is part of the spinal cord.   The axon turns caudally and dorsally, coursing between the surface of the spinal cord and the medial surface of the axial muscles to the dorsal median septum. The MiP axon then extends dorsally to the surface of the muscle, where it turns to arborize ventrally over the lateral surface of the axial muscle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-1247</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-272</oboInOwl:hasDbXref>
