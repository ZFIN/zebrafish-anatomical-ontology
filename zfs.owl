                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cerebrospinal fluid contacting neuron that originates form p3 progenitor domain. The apical extension of ventral CSF-cNs are more compact than that of dorsal CSF-cNs. Ventral CSF-cNs synapse with CaP motor neurons and project onto CoPA sensory interneurons. Ventral CSF-cNs respond to longitudinal contractions of the spinal cord.  Frequently called &quot;KA neurons&quot;.</obo:IAO_0000115>
        <oboInOwl:created_by>Yvonne</oboInOwl:created_by>
        <oboInOwl:creation_date>2020-03-03T10:51:35Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>ventral CSF-cN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral CSF-cNs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>KA 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0007121</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:label>ventral cerebrospinal fluid contacting neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
