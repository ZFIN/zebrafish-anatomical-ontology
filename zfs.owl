                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Twelve pairs of cranial nerves exit/enter the cranium through openings in the skull. The nerves contain efferent axons with motor and glandular functions, as well as afferent axons from cranial ganglia with sensory functions. The nerves are numbered in a rostral to caudal sequence, with the exception of the lateral line nerves.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0000641</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cranial nerves</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0000641</oboInOwl:id>
        <rdfs:label>cranial nerve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Twelve pairs of cranial nerves exit/enter the cranium through openings in the skull. The nerves contain efferent axons with motor and glandular functions, as well as afferent axons from cranial ganglia with sensory functions. The nerves are numbered in a rostral to caudal sequence, with the exception of the lateral line nerves.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORCID:0000-0001-9114-8737</oboInOwl:hasDbXref>
    </owl:Axiom>
