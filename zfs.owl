            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Tract that originates in the telencephalon lies medial to the lateral forebrain bundle and extends into the diencephalon approaching the posterior tuberal nucleus.  In embryos the tract connects cells in the ventral olfactory bulb to those in the septal area.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0005111</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>medial forebrain bundles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0005111</oboInOwl:id>
        <rdfs:label>medial forebrain bundle</rdfs:label>
    </owl:Class>
