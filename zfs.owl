                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>CNS white matter, an axonal tract between ventral diencephalon and ventral telencephalon.  At 3 d, the anterior catecholaminergic tract includes noradrenergic projections from the hindbrain and dopaminergic projections from ventral dopaminergic neurons. During later development, other catecholaminergic projections may also contribute to the anterior catecholaminergic tract.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-18T06:11:28Z</oboInOwl:creation_date>
