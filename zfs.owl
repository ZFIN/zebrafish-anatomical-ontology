    <!-- http://purl.obolibrary.org/obo/ZFA_0001181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0001181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001477"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000041"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The tissue which lies between the basal stratum and the superficial stratum.   This layer is composed of a variable number of cell layers which contain  mucous goblet cells, club cells and sensory cells.  Most of the cells of this region are undifferentiated. They serve as a reservoir to replace dead cells in any of the epidermis regions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001181</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001181</oboInOwl:id>
        <rdfs:label>epidermal intermediate stratum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The tissue which lies between the basal stratum and the superficial stratum.   This layer is composed of a variable number of cell layers which contain  mucous goblet cells, club cells and sensory cells.  Most of the cells of this region are undifferentiated. They serve as a reservoir to replace dead cells in any of the epidermis regions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-040726-12</oboInOwl:hasDbXref>
    </owl:Axiom>
    


