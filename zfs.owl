            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of a series of paired bony or cartilaginous arches that develop along the lateral walls of the foregut. The pharyngeal arches have developmental contributions from endoderm, mesoderm, and neural crest cells and are separated by anterior lateral endoderm out-pockets known as pharyngeal pouches. There are seven pharyngeal arches.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001306</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pharyngeal arches</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ZFA:0001306</oboInOwl:id>
        <rdfs:label>pharyngeal arch</rdfs:label>
    </owl:Class>
