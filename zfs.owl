    <!-- http://purl.obolibrary.org/obo/ZFA_0007004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0007004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001477"/>
        <rdfs:subClassOf>
