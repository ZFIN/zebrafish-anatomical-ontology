                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oocyte part of stage III ovarian follicle.  Stage III oocytes contain internal vitellus droplets and peripheral yolk vesicles.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0001566</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Stage 3 oocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oocytes stage III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vitellogenic oocytes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>postvitellogenic oocyte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0001566</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>In stage III (vitellogenesis), yolk proteins appear in oocytes and yolk bodies with crystalline yolk accrue during this major growth stage. Oocytes develop the capacity to respond in vitro to the steroid 17, 20-dihydroxy-4-pregnen-3-one (DHP) by undergoing oocyte maturation  ZDB-PUB-961014-1020.</rdfs:comment>
        <rdfs:label>oocyte stage III</rdfs:label>
    </owl:Class>
