    <!-- http://purl.obolibrary.org/obo/ZFA_0005815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002496"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFS_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>TARGET DEFINITION: Hindbrain interneurons that are part of the reticular formation.  The T interneurons receive synaptic input from the  Mauthner neuron,  from unidentified axons in the mlf, and perhaps from trigeminal sensory fibers.  .  The axon is T-shaped the proximal segment courses to the midline of the  brain and near the midline bifurcates to form an ascending rostral segment and a descending caudal segment.  The rostral and caudal segments join the dorsal component of the MLF.  The T interneurons are located caudal to CaD and appear to be bilaterally paired. They project to cranial and pectoral motor nuclei.</obo:IAO_0000115>
        <oboInOwl:created_by>Ceri</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-07-31T02:33:52Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId>ZFA:0005182</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>TAO:0005182</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>T-interneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>t-interneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>T shaped reticular neuron </oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cranial relay neuron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0005815</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/zfa#cell_slim"/>
        <rdfs:comment>This term is a leaf node in the zebrafish AO and is not in the CL.</rdfs:comment>
        <rdfs:label>T interneuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>TARGET DEFINITION: Hindbrain interneurons that are part of the reticular formation.  The T interneurons receive synaptic input from the  Mauthner neuron,  from unidentified axons in the mlf, and perhaps from trigeminal sensory fibers.  .  The axon is T-shaped the proximal segment courses to the midline of the  brain and near the midline bifurcates to form an ascending rostral segment and a descending caudal segment.  The rostral and caudal segments join the dorsal component of the MLF.  The T interneurons are located caudal to CaD and appear to be bilaterally paired. They project to cranial and pectoral motor nuclei.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cvs</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORCID:0000-0002-2244-7917</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-961014-588</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>cranial relay neuron</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFIN:ZDB-PUB-110110-13</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ZFA_0005816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005816">
