    <!-- http://purl.obolibrary.org/obo/ZFA_0000344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0000344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0001469"/>
        <rdfs:subClassOf>
