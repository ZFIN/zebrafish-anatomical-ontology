    <!-- http://purl.obolibrary.org/obo/ZFA_0005966 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ZFA_0005966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ZFA_0009366"/>
