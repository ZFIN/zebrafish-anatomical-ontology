            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Paired, deep caudal fin muscles that arise from a narrow insertion site at the 28th and 29th vertebrae then project from the vertebral column to the ventral base of the caudal fin where they attach broadly to ventral caudal fin rays.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TAO:0000269</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>flexor caudalis ventralis inferioris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>inferior ventral flexor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>zebrafish_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>CVI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ZFA:0000269</oboInOwl:id>
        <rdfs:label>inferior caudal ventral flexor</rdfs:label>
    </owl:Class>
